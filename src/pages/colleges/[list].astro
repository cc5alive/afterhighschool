---
// State pages (/colleges/texas) and a few topic pages (/colleges/test-optional).
import Layout from '../../layouts/Layout.astro';
import Directory from '../../components/Directory.astro';
import { pulledDate } from '../../lib/data.js';
import { collegeLists } from '../../lib/college-lists.js';
import { COLLEGES_LAUNCHED } from '../../lib/site.js';

export function getStaticPaths() {
  return collegeLists().map(({ slug, ...props }) => ({ params: { list: slug }, props }));
}

const { title, intro, preset, list, stateName, lowCost } = Astro.props;
// Every list gets a plain A-to-Z list of links, so each college on it can be reached without JavaScript.
const az = [...list].sort((a, b) => a.name.localeCompare(b.name));
const path = `/colleges/${Astro.params.list}`;
---
<Layout title={`${title} | After High School`} description={intro} crumbs={[['Colleges', '/colleges']]} path={path} nav="colleges" noindex={!COLLEGES_LAUNCHED}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/colleges">Colleges</a></nav>
  <section class="dir-head">
    <h1>{title}</h1>
    <p>{intro}</p>
    <p>Data from College Scorecard, last pulled {pulledDate}.</p>
    {lowCost && <p><a href={`/colleges/${lowCost}`}>Low-cost colleges in {stateName}</a></p>}
  </section>
  <Directory initial={list.slice(0, 50)} total={list.length} preset={preset} />
  {az.length > 0 && (
    <section class="block" aria-labelledby="az">
      <h2 id="az">{stateName ? `Every college in ${stateName}, A to Z` : `All ${az.length} colleges on this list, A to Z`}</h2>
      <ul class="az-list">
        {az.map((s) => <li><a href={`/college/${s.slug}`}>{s.name}</a> <span>{s.city}</span></li>)}
      </ul>
    </section>
  )}
</Layout>
