---
// Schools in one state that offer one trade.
import Layout from '../../../layouts/Layout.astro';
import { tradeIndex, national, tradePulledDate, KIND_LABEL } from '../../../lib/trade-data.js';
import { CREDENTIAL } from '../../../lib/trades.js';
import { money, int, pct, OWNERSHIP_LABEL } from '../../../lib/format.js';
import { TRADES_LAUNCHED, LOCAL_GUIDES_LAUNCHED } from '../../../lib/site.js';
export function getStaticPaths() {
  return tradeIndex.flatMap((t) => t.states.map((st) => ({ params: { trade: t.slug, state: st.slug }, props: { t, st } })));
}
const { t, st } = Astro.props;
const creds = (progs) => [...new Set(progs.map((p) => CREDENTIAL[p.level]))].join(', ');
const finished = (progs) => progs.reduce((a, p) => a + (p.awards || 0), 0);
// This program's own graduates: what they earned a year after finishing, by credential, where reported.
const progEarn = (progs) => {
  const withPay = progs.filter((p) => p.earn1);
  const sameLevel = new Set(progs.map((p) => p.level)).size < progs.length;
  const tag = (p) => progs.length < 2 ? '' : ` (${sameLevel ? p.title : CREDENTIAL[p.level].toLowerCase()})`;
  return withPay.map((p) => `${money(p.earn1)}${tag(p)}`).join(' · ') || null;
};
---
<Layout title={`${t.name} schools in ${st.name} | After High School`}
  description={`${st.list.length} schools in ${st.name} offer ${t.name.toLowerCase()} programs. Compare cost, completion and earnings from federal data.`}
  crumbs={[['Trades', '/trades'], [t.name, `/trades/${t.slug}`]]}
  path={`/trades/${t.slug}/${st.slug}`} nav="colleges" noindex={!TRADES_LAUNCHED}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/trades">Trades</a><span aria-hidden="true">/</span><a href={`/trades/${t.slug}`}>{t.name}</a></nav>
  <section class="compare-head">
    <h1>{t.name} schools in {st.name}</h1>
    <p>{st.list.length} {st.list.length === 1 ? 'school offers' : 'schools offer'} a certificate or associate degree in {t.name.toLowerCase()}, listed A to Z. Numbers are from federal data; open a school for its programs, costs by family income and sources.</p>
    {LOCAL_GUIDES_LAUNCHED && t.slug === 'electrician' && st.code === 'CA' && <p>In Los Angeles County? See <a href="/guides/electrician-los-angeles">every route to becoming an electrician in LA</a>, including paid apprenticeships.</p>}
  </section>
  <ul class="results tr-results">
    {st.list.map(({ s, progs }) => (
      <li class="card tr-card">
        <div class="card-main">
          <a class="card-link" href={`/trades/school/${s.slug}`}>
            <span class="card-name">{s.name}</span>
            <span class="card-where">{s.city} · {KIND_LABEL[s.kind]} · {OWNERSHIP_LABEL[s.ownership]}</span>
          </a>
          <button type="button" class="linkish card-save" data-save-slug={`t:${s.slug}`} data-off-text="Save to my list" data-on-text="Saved" aria-pressed="false" aria-label={`Save ${s.name} to my list`}>Save to my list</button>
        </div>
        <dl class="card-facts tr-facts">
          <div><dt>Offers</dt><dd>{creds(progs)}</dd></div>
          <div><dt>Finished this program last year</dt><dd>{int(finished(progs)) ?? '—'}</dd></div>
          <div><dt>This program's graduates, a year after finishing</dt><dd>{progEarn(progs) ?? 'Not reported'}</dd></div>
          <div><dt>Avg net price (whole school)</dt><dd>{money(s.avgNetPrice) ?? '—'}</dd></div>
          <div><dt>Finish rate (whole school)</dt><dd>{pct(s.completionRate) ?? '—'}</dd></div>
          <div><dt>Median earnings (whole school)</dt><dd>{money(s.medianEarnings6yr) ?? '—'}</dd></div>
        </dl>
      </li>
    ))}
  </ul>
  <p class="wys-src">"This program's graduates" is what this school's graduates in {t.name.toLowerCase()} earned a year after finishing, among those who got federal aid, from College Scorecard's program data; many programs are too small to report. The "whole school" figures cover every student at the school, not just this program: the finish rate is the share of first-time, full-time students who finish within 1.5 times the normal length, and median earnings are for students who got federal aid, 6 years after they started. Data from College Scorecard, pulled {tradePulledDate}.</p>
</Layout>
