---
import { CONTACT_EMAIL, TRADES_LAUNCHED, APPRENTICESHIPS_LAUNCHED, TRANSFER_LAUNCHED, GAP_LAUNCHED, MILITARY_LAUNCHED, SELF_LAUNCHED, COUNSELORS_LAUNCHED } from '../lib/site.js';

const {
  title,
  description,
  path = '/',
  noindex = false,
  nav = 'home',          // 'colleges' also loads colleges.css and the save buttons; every page shows the main menu
  ogTitle,
  jsonLd,                // one schema.org object or an array of them
  crumbs                 // [[name, path], ...] above this page, for BreadcrumbList markup
} = Astro.props;
const SITE = 'https://afterhighschool.me';
const ld = [...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
if (crumbs?.length && !noindex) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [...crumbs, [ogTitle ?? title.replace(/ \| After High School$/, ''), path]].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(p, SITE).toString() }))
  });
}
const canonical = new URL(path, 'https://afterhighschool.me').toString().replace(/\/$/, path === '/' ? '/' : '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:title" content={ogTitle ?? title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="After High School">
  <meta property="og:image" content="https://afterhighschool.me/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="After High School: every road out of high school, with the real numbers. A route map from graduation to college, trades, apprenticeships, gap years, the military and teaching yourself.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#16233B">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preload" href="/fonts/overpass-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/overpass-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/overpass-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">
  {nav === 'colleges' && <link rel="stylesheet" href="/colleges.css">}
  {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body>
  <header class="site-header">
    <a class="wordmark" href="/">afterhighschool<span class="tld">.me</span></a>
    <nav class="section-nav" aria-label="Main">
        <a href="/colleges">Colleges</a>
        <details class="nav-paths">
          <summary>Other paths</summary>
          <div class="nav-menu">
            {TRADES_LAUNCHED && <a href="/trades">Trade schools</a>}
            {APPRENTICESHIPS_LAUNCHED && <a href="/apprenticeships">Apprenticeships</a>}
            {TRANSFER_LAUNCHED && <a href="/transfer">Community college and transfer</a>}
            {GAP_LAUNCHED && <a href="/gap-years">Gap years</a>}
            {MILITARY_LAUNCHED && <a href="/military">Military</a>}
            {SELF_LAUNCHED && <a href="/teach-yourself">Teach yourself</a>}
            {SELF_LAUNCHED && <a href="/fellowships">Fellowships</a>}
            <a class="nav-all" href="/paths">Every path, side by side</a>
          </div>
        </details>
        <a href="/compare">Compare<span class="nav-long"> colleges</span></a>
        <a href="/my-list">My list<span data-list-count></span></a>
    </nav>
  </header>

  <main>
    <slot />
  </main>
  {nav === 'colleges' && <script>import { wireSaveButtons } from '../lib/mylist.js'; wireSaveButtons();</script>}
  <script>
    // Close the paths menu when you click elsewhere or press Escape.
    const menu = document.querySelector('.nav-paths');
    document.addEventListener('click', (e) => { if (menu && !menu.contains(e.target)) menu.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary').focus(); } });
  </script>

  <footer class="site-footer">
    <slot name="footer">
      <p>Made in Los Angeles by CC Pearce and Young Chu. Questions or ideas: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      <p class="footer-links">
        {nav === 'colleges' && <a href="/methodology">How our data works</a>}
        {COUNSELORS_LAUNCHED && <a href="/counselors">For counselors and teachers</a>}
        <a href="/privacy">Privacy</a>
      </p>
    </slot>
  </footer>
  <slot name="scripts" />
</body>
</html>
