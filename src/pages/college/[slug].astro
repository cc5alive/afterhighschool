---
import { schoolLink } from '../../lib/links.js';
import Layout from '../../layouts/Layout.astro';
import Stat from '../../components/Stat.astro';
import CdsPanel from '../../components/CdsPanel.astro';
import WhereYouStand from '../../components/WhereYouStand.astro';
import { allSchools, similarSchools, easierSchools, pulledDate, stateSlug, highlights, schoolStatus, bySlug, gradOnly, cds } from '../../lib/data.js';
import {
  pct, money, int, OWNERSHIP_LABEL, SETTING_LABEL, TEST_POLICY_LABEL, TEST_POLICY_DETAIL,
  INCOME_BAND_LABEL, admitRateText, scorecardUrl
} from '../../lib/format.js';
import { COLLEGES_LAUNCHED, CONTACT_EMAIL } from '../../lib/site.js';

// Colleges that share a name with another listed college (Bethel University, Lincoln University ...): titles add the place.
const nameUses = new Map();
for (const x of allSchools) nameUses.set(x.name, (nameUses.get(x.name) || 0) + 1);
const sharedName = new Set([...nameUses].filter(([, n]) => n > 1).map(([n]) => n));

export function getStaticPaths() {
  return allSchools.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const src = scorecardUrl(s);
const site = schoolLink(s.url);
const calc = schoolLink(s.priceCalculatorUrl);
const similar = similarSchools(s);
const hl = highlights.get(s.slug);
const reviewedDate = hl && new Date(`${hl.reviewedAt}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const easier = easierSchools(s);
const cd = cds.get(s.slug);
const status = schoolStatus.get(s.slug);
const statusRelated = status?.related && bySlug.get(status.related);
const statusChecked = status && new Date(`${status.checkedAt}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const bands = Object.entries(s.netPriceByIncome).map(([k, v]) => ({ k, label: INCOME_BAND_LABEL[k], v }));
const bandMax = Math.max(1, ...bands.map((b) => b.v ?? 0), s.costOfAttendance ?? 0);
const hasBands = bands.some((b) => b.v != null);

const chips = [
  OWNERSHIP_LABEL[s.ownership],
  s.setting && SETTING_LABEL[s.setting],
  s.undergrads != null && `${int(s.undergrads)} undergrads`,
  s.hbcu && 'HBCU',
  s.tribalCollege && 'Tribal college',
  s.womenOnly && "Women's college",
  s.menOnly && "Men's college",
  s.onlineOnly && 'Online only'
].filter(Boolean);

// One SAT and one ACT figure per school (see testScores in lib/data.js): the school's own Common Data Set
// when we have it, never a total built by adding Scorecard's section ranges.
const cdsYear = cd?.cdsYear ? cd.cdsYear.replace(/^(\d{4})-\d{2}(\d{2})$/, '$1–$2') : null;
const cdsLabel = `${s.name} Common Data Set${cdsYear ? ` ${cdsYear}` : ''}`;
const sentNote = (submit, test) => submit != null ? `the ${Math.round(submit)}% of enrolled first-years who sent ${test} scores` : `enrolled first-years who sent ${test} scores`;
const satRange = s.satRange ? `${s.satRange[0]}–${s.satRange[2]}` : null;
const satSec = !satRange && s.satSections ? s.satSections : null;
const sat = satRange
  ? { label: 'SAT (middle 50%)', value: satRange, note: `Total score, ${sentNote(s.satSubmit, 'SAT')}`, href: cd.source.url, srcLabel: cdsLabel }
  : satSec
    ? { label: 'SAT section scores (middle 50%)', value: `Reading ${satSec.reading[0]}–${satSec.reading[1]} · Math ${satSec.math[0]}–${satSec.math[1]}`, note: 'Each section separately, enrolled first-years who sent scores. We don\'t have the school\'s own total range yet, and adding the two ranges wouldn\'t give one.', href: src }
    : { label: 'SAT (middle 50%)', value: null, href: src };
const actRange = s.actRange ? `${s.actRange[0]}–${s.actRange[2]}` : null;
const act = s.actFrom === 'cds'
  ? { value: actRange, note: `Composite, ${sentNote(s.actSubmit, 'ACT')}`, href: cd.source.url, srcLabel: cdsLabel }
  : { value: actRange, note: actRange && 'Composite, enrolled first-years who sent scores', href: src };
const admit = admitRateText(s);
const admitNote = s.admitRate != null
  ? (s.admitRate < 0.1
      ? `About 1 in ${Math.round(1 / Math.max(s.admitRate, 0.01))} applicants get in.`
      : `About ${Math.round(s.admitRate * 10)} in 10 applicants get in.`)
  : s.openAdmission ? 'Admits nearly everyone who applies.' : null;

const description = `${s.name} in ${s.city}, ${s.stateName}: admit rate, test scores, real cost by family income, graduation rate and earnings, from federal data.`;
// Short names students search for (UCLA, MIT, ABAC) go first in the title; former names and long
// aliases don't.
const isAbbr = (c) => /^[A-Z][A-Za-z&.\-]{1,9}$/.test(c) && (c.match(/[A-Z]/g) || []).length >= 2;
// An abbreviation only counts if its capitals follow the initials of the current name (UCLA, MIT),
// so a former name's abbreviation doesn't end up in the title.
const initials = s.name.split(/[\s\-&,]+/).filter(Boolean).map((w) => w[0].toUpperCase()).join('');
const fitsName = (abbr) => {
  let i = 0;
  for (const ch of abbr.replace(/[^A-Z]/g, '')) { i = initials.indexOf(ch, i); if (i < 0) return false; i++; }
  return true;
};
const shortAlias = (() => {
  for (const c of (s.alias || '').split(/\s*[,|;]\s*|\s{2,}/).map((x) => x.trim()).filter(Boolean)) {
    const words = c.split(' ');
    const pick = isAbbr(c) ? c
      : words.length <= 3 && c.length <= 20 && (words.some(isAbbr) || /\bTech$/.test(c)) ? c
      : isAbbr(words[0]) ? words[0] : null;
    if (!pick || s.name.includes(pick) || (!pick.includes(' ') && pick.replace(/[^A-Z]/g, '').length < 3)) continue;
    if (/\bTech$/.test(pick) || pick.split(' ').filter(isAbbr).every(fitsName)) return pick;
  }
  return null;
})();
const titleName = `${shortAlias ? `${shortAlias} (${s.name})` : s.name}${sharedName.has(s.name) ? ` (${s.city}, ${s.state})` : ''}`;
const titleTopic = s.admitRate != null ? 'acceptance rate, cost and outcomes' : 'admissions, cost and outcomes';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollegeOrUniversity',
  name: s.name,
  ...(s.alias ? { alternateName: s.alias } : {}),
  ...(site ? { url: site } : {}),
  address: { '@type': 'PostalAddress', addressLocality: s.city, addressRegion: s.state, postalCode: s.zip, addressCountry: 'US' }
};
const submitMail = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`What's special: ${s.name}`)}`;
const errorMail = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Data error: ${s.name}`)}`;
---
<Layout title={`${titleName}: ${titleTopic} | After High School`} description={description}
  crumbs={[['Colleges', '/colleges'], [s.stateName, `/colleges/${stateSlug(s.state)}`]]} ogTitle={titleName}
  path={`/college/${s.slug}`} nav="colleges" noindex={!COLLEGES_LAUNCHED || status?.listed === false || gradOnly(s)} jsonLd={jsonLd}>
  <article class="school">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/colleges">Colleges</a> <span aria-hidden="true">/</span>
      <a href={`/colleges/${stateSlug(s.state)}`}>{s.stateName}</a>
    </nav>

    <header class="school-head">
      <h1>{s.name}</h1>
      <p class="school-where">{s.city}, {s.stateName}</p>
      <ul class="chips">{chips.map((c) => <li>{c}</li>)}</ul>
      <p class="school-links">
        {site && <a class="button" href={site} rel="noopener" target="_blank">School website</a>}
        {calc && <a class="button secondary" href={calc} rel="noopener" target="_blank">Net price calculator</a>}
        {status?.listed !== false && !gradOnly(s) && <a class="button secondary" href={`/compare?schools=${s.slug}`}>Compare</a>}
        {status?.listed !== false && !gradOnly(s) && <button type="button" class="button secondary" data-save-slug={s.slug} aria-pressed="false">Save to my list</button>}
      </p>
    </header>

    {status && (
      <aside class={`status-notice status-${status.kind}`} role="note">
        <p class="status-head"><strong>{status.headline}</strong></p>
        <p>{status.text}</p>
        {statusRelated && <p><a href={`/college/${statusRelated.slug}`}>See {statusRelated.name}</a></p>}
        <p class="status-src">Source{status.sources.length > 1 ? 's' : ''}: {status.sources.map((x, i) => <>{i > 0 && ', '}<a href={x.url} rel="nofollow noopener">{x.title}</a></>)}. Checked {statusChecked}.</p>
      </aside>
    )}

    {gradOnly(s) && !status && (
      <aside class="notice">
        <strong>Graduate students only.</strong> This school doesn't report any undergraduates to the federal government, so it isn't a place to start right after high school.
      </aside>
    )}

    {s.ownership === 'private_for_profit' && (
      <aside class="notice">
        <strong>This is a for-profit school.</strong> Check the graduation rate, earnings and debt below closely, and compare with public options near you.
      </aside>
    )}

    <section class="glance" aria-label="At a glance">
      <dl class="glance-grid">
        <Stat big label="Admit rate" value={admit} href={src} />
        <Stat big label="Average net price" value={money(s.avgNetPrice)} note="per year, after grants" href={src} />
        <Stat big label="Graduation rate" value={pct(s.gradRate)} note="within 6 years" href={src} />
        <Stat big label="Median earnings" value={money(s.medianEarnings10yr)} note="10 years after starting" href={src} />
      </dl>
    </section>

    <section class="block" aria-labelledby="special">
      <h2 id="special">What's special</h2>
      {hl ? (
        <>
          <ul class="highlights">
            {hl.facts.map((f) => (
              <li>
                <p>{f.text}</p>
                <p class="hl-src">Source: {f.sources.map((x, i) => (
                  <>{i > 0 && '; '}<a href={x.url} rel="noopener" target="_blank">{x.title}</a></>
                ))}</p>
              </li>
            ))}
          </ul>
          <p class="hl-meta">Written by us from the linked sources and checked against them on {reviewedDate}. Programs and policies change, so confirm details with the school.</p>
        </>
      ) : (
        <p class="pending-note">We haven't added a fact about {s.name} yet. Every fact here has to link to a source we can check, and we're still working through schools.</p>
        <p class="pending-note">Know something that makes {s.name} different, like a tuition promise, an unusual calendar or a requirement every student completes? <a href={submitMail}>Email {CONTACT_EMAIL}</a> with a link to where it's stated. We'll check it and add it.</p>
      )}
    </section>

    <section class="block" aria-labelledby="getting-in">
      <h2 id="getting-in">Getting in</h2>
      <dl class="stat-grid">
        <Stat label="Admit rate" value={admit} note={admitNote} href={src} />
        <Stat label="Test policy" value={s.testPolicy && TEST_POLICY_LABEL[s.testPolicy]} note={s.testPolicy && TEST_POLICY_DETAIL[s.testPolicy]} href={src} />
        <Stat label={sat.label} value={sat.value} note={sat.note} missing="Not reported" href={sat.href} srcLabel={sat.srcLabel} />
        <Stat label="ACT (middle 50%)" value={act.value} note={act.note} missing="Not reported" href={act.href} srcLabel={act.srcLabel} />
      </dl>
      {cd && <CdsPanel c={cd} name={s.name} />}
      {!s.openAdmission && <WhereYouStand s={s} c={cd} scorecardHref={src} />}
    </section>

    <section class="block" aria-labelledby="cost">
      <h2 id="cost">What it really costs</h2>
      <p class="block-lede">Most families pay less than the sticker price. Net price is what's left after grants and scholarships.</p>
      {hasBands ? (
        <figure class="bars">
          <figcaption>Average net price per year, by family income</figcaption>
          <svg viewBox="0 0 520 200" role="img" aria-label={`Average net price by family income at ${s.name}`}>
            {bands.map((b, i) => (
              <g>
                <text x="0" y={i * 38 + 24} class="bar-label">{b.label}</text>
                <rect x="110" y={i * 38 + 8} height="22" rx="4" class="bar-track" width="300" />
                {b.v != null && <rect x="110" y={i * 38 + 8} height="22" rx="4" class="bar-fill" width={Math.max(4, (b.v / bandMax) * 300)} />}
                <text x="422" y={i * 38 + 24} class="bar-value">{b.v != null ? money(b.v) : 'Not reported'}</text>
              </g>
            ))}
          </svg>
          <a class="src" href={src} rel="noopener" target="_blank">Source: College Scorecard</a>
        </figure>
      ) : null}
      <dl class="stat-grid">
        <Stat label="Average net price" value={money(s.avgNetPrice)} note="full-time first-years who got grant aid" href={src} />
        <Stat label="Total cost of attendance" value={money(s.costOfAttendance)} note="sticker price incl. housing, per year" href={src} />
        <Stat label={s.ownership === 'public' ? 'Tuition, in-state' : 'Tuition'} value={money(s.tuitionInState)} href={src} />
        {s.ownership === 'public' && <Stat label="Tuition, out-of-state" value={money(s.tuitionOutOfState)} href={src} />}
      </dl>
    </section>

    <section class="block" aria-labelledby="outcomes">
      <h2 id="outcomes">After you enroll</h2>
      <dl class="stat-grid">
        <Stat label="Graduation rate" value={pct(s.gradRate)} note="first-time, full-time students finishing within 6 years" href={src} />
        <Stat label="Came back for year two" value={pct(s.retentionRate)} note="full-time first-year students" href={src} />
        <Stat label="Median earnings" value={money(s.medianEarnings10yr)} note="10 years after starting, for students who got federal aid" href={src} />
        <Stat label="Median debt at graduation" value={money(s.medianDebt)} note="federal loans, students who finished" href={src} />
      </dl>
    </section>

    <section class="block" aria-labelledby="students">
      <h2 id="students">Students</h2>
      <dl class="stat-grid">
        <Stat label="Undergraduates" value={int(s.undergrads)} href={src} />
        <Stat label="Receive Pell grants" value={pct(s.pellRate)} note="a sign of economic diversity" href={src} />
        <Stat label="First-generation students" value={pct(s.firstGenShare)} note="parents didn't go beyond high school" href={src} />
      </dl>
    </section>

    {(similar.length > 0 || easier.length > 0) && (
      <section class="block" aria-labelledby="similar">
        <h2 id="similar">Similar schools</h2>
        {easier.length > 0 && (
          <>
            <h3>Similar, and easier to get into</h3>
            <ul class="mini-list">
              {easier.map((o) => <li><a href={`/college/${o.slug}`}>{o.name}</a> <span>{o.city}, {o.state} — admits {pct(o.admitRate)}</span></li>)}
            </ul>
          </>
        )}
        <h3>Also worth a look</h3>
        <ul class="mini-list">
          {similar.map((o) => <li><a href={`/college/${o.slug}`}>{o.name}</a> <span>{o.city}, {o.state}{o.admitRate != null ? ` — admits ${pct(o.admitRate)}` : ''}</span></li>)}
        </ul>
      </section>
    )}

    <section class="block sources" aria-labelledby="sources">
      <h2 id="sources">Where these numbers come from</h2>
      <p>{cd ? <>Numbers marked with the school's Common Data Set come from that report. The rest come from</> : <>Every number on this page comes from</>} the U.S. Department of Education's <a href={src} rel="noopener" target="_blank">College Scorecard page for {s.name}</a>, which draws on what the school reports to the federal government and on federal student aid and tax records. We last pulled the data on {pulledDate}. Different measures cover different years; <a href="/methodology">here's how each one works</a>.</p>
      <p>Spot something wrong? <a href={errorMail}>Report a data error</a>.</p>
    </section>
  </article>
</Layout>
